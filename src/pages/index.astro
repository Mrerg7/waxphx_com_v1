---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WhySection from '../components/WhySection.astro';
import MarketSection from '../components/MarketSection.astro';
import UseCasesSection from '../components/UseCasesSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import OfferForm from '../components/OfferForm.astro';
import FaqList from '../components/FaqList.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import { SITE } from '../config/site';
---

<BaseLayout includeProduct>
  <Nav />
  <main id="content">
    <Hero />
    <WhySection />
    <MarketSection />
    <UseCasesSection />
    <ProcessSection />
    <section class="bg-paper">
      <div class="mx-auto grid max-w-page gap-10 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-clay">Questions</p>
          <h2 class="mt-3 font-display text-4xl tracking-tight">Before you write.</h2>
          <p class="mt-4 text-sm text-mute">
            Short answers for buyers. The full set, with the same wording search engines can read, lives on the
            <a class="font-semibold text-clay underline decoration-clay/30 underline-offset-4" href="/faq/">FAQ page</a>.
          </p>
          <p class="mt-6 text-sm text-mute">
            Direct line: <a class="font-semibold text-ink" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
        </div>
        <FaqList />
      </div>
    </section>
    <section class="bg-cream">
      <div class="mx-auto max-w-page px-5 py-16 md:px-8 md:py-24">
        <OfferForm />
      </div>
    </section>
  </main>
  <Footer />
  <StickyBar />
</BaseLayout>
