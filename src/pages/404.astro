---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page not found — waxphx.com';
const description = 'That page is not on waxphx.com. Return to the domain sale.';
---

<BaseLayout title={title} description={description} noindex>
  <main id="content" class="flex min-h-screen items-center bg-cream px-5">
    <div class="mx-auto max-w-lg text-center">
      <p class="font-display text-7xl text-clay">404</p>
      <h1 class="mt-4 font-display text-4xl tracking-tight">This page is not part of the sale.</h1>
      <p class="mt-3 text-mute">waxphx.com is a domain listing. The offer, the price, and the market note are on the homepage.</p>
      <a href="/" class="mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-ink px-6 font-semibold text-cream">
        Back to waxphx.com
      </a>
    </div>
  </main>
</BaseLayout>
