---
import { BRAND_IMAGE, SITE } from '../config/site';
import Icon from './Icon.astro';
---

<section class="bg-ink text-cream">
  <div class="mx-auto grid max-w-page items-center gap-10 px-5 py-12 md:px-8 md:py-20 lg:grid-cols-[1.05fr_0.95fr]">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-gold">Domain for sale · not a salon</p>
      <h1 class="mt-4 font-display text-[clamp(3.1rem,11vw,5.6rem)] leading-[0.92] tracking-tight">
        waxphx<span class="text-gold">.com</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg text-mist sm:text-xl">
        The six-letter .com for Phoenix waxing and hair removal. Short enough for a sign. Exact enough for the search.
      </p>
      <div class="mt-8 flex flex-wrap items-end gap-6">
        <div>
          <p class="text-xs uppercase tracking-[0.16em] text-mist">Asking price</p>
          <p class="font-display text-5xl tracking-tight">{SITE.askingPriceLabel}</p>
        </div>
        <p class="max-w-xs pb-1 text-sm text-mist">USD. Offers reviewed. Domain registration only — no business attached.</p>
      </div>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#offer" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-gold px-6 font-semibold text-ink">
          Make an offer
          <Icon name="arrow" />
        </a>
        <a href="/acquire/" class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/20 px-6 font-medium text-cream">
          How acquisition works
        </a>
      </div>
    </div>

    <figure class="min-w-0">
      <img
        src={BRAND_IMAGE}
        width="1600"
        height="873"
        alt="Charcoal card with a gold phoenix mark and the wordmark WAXPHX.com"
        class="w-full rounded-2xl border border-white/10 shadow-2xl"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="mt-3 text-center text-xs tracking-wide text-mist">The mark buyers will put on the door.</figcaption>
    </figure>
  </div>
</section>
