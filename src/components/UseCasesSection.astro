---
const cases = [
  {
    title: 'Flagship salon or small chain',
    body: 'Put the obvious Phoenix name on the studio people already try to spell.',
  },
  {
    title: 'Mobile and concierge waxing',
    body: 'Six letters travel well by text. Clients can repeat it after one appointment.',
  },
  {
    title: 'Booking directory',
    body: 'A neutral metro name can sit above individual artists without sounding like one room.',
  },
  {
    title: 'Academy or product line',
    body: 'Train waxers, or sell aftercare, under a name that already says the city and the craft.',
  },
];
---

<section id="uses" class="scroll-mt-24 border-y border-line bg-cream">
  <div class="mx-auto max-w-page px-5 py-16 md:px-8 md:py-24">
    <h2 class="max-w-xl font-display text-4xl tracking-tight sm:text-5xl">What a buyer actually does with it.</h2>
    <div class="mt-10 grid gap-px overflow-hidden rounded-3xl border border-line bg-line sm:grid-cols-2">
      {
        cases.map((item) => (
          <article class="bg-paper p-7">
            <h3 class="text-xl font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-mute">{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
