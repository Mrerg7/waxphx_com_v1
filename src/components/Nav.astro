---
import { NAV, SITE } from '../config/site';
import Icon from './Icon.astro';
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink/95 text-cream backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-page items-center justify-between gap-4 px-5 md:h-[4.5rem] md:px-8">
    <a href="/" class="min-w-0 font-display text-2xl tracking-tight text-cream">
      waxphx<span class="text-gold">.com</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        NAV.map((item) => (
          <a href={item.href} class="rounded-full px-3 py-2 text-sm text-mist hover:text-cream">
            {item.label}
          </a>
        ))
      }
      <a
        href="/#offer"
        class="ml-2 inline-flex min-h-11 items-center rounded-full bg-gold px-4 text-sm font-semibold text-ink"
      >
        Make an offer
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary class="flex h-11 w-11 items-center justify-center rounded-full border border-white/15">
        <span class="sr-only">Open menu</span>
        <Icon name="menu" />
      </summary>
      <nav
        class="absolute right-0 top-14 w-64 rounded-2xl border border-white/10 bg-panel p-2 shadow-2xl"
        aria-label="Mobile"
      >
        {
          NAV.map((item) => (
            <a href={item.href} class="block rounded-xl px-3 py-3 text-sm text-cream">
              {item.label}
            </a>
          ))
        }
        <a href="/#offer" class="mt-1 flex min-h-11 items-center justify-center rounded-xl bg-gold px-3 text-sm font-semibold text-ink">
          Make an offer · {SITE.askingPriceLabel}
        </a>
      </nav>
    </details>
  </div>
</header>
