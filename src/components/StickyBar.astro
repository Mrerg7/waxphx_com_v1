---
import { SITE } from '../config/site';
---

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-ink/95 px-4 py-3 text-cream backdrop-blur md:hidden">
  <div class="mx-auto flex max-w-page items-center justify-between gap-3">
    <div>
      <p class="text-[11px] uppercase tracking-[0.16em] text-mist">Asking</p>
      <p class="font-display text-2xl leading-none">{SITE.askingPriceLabel}</p>
    </div>
    <a href="/#offer" class="inline-flex min-h-11 items-center rounded-full bg-gold px-4 text-sm font-semibold text-ink">
      Make an offer
    </a>
  </div>
</div>
