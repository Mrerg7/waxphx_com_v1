---
import '../styles/global.css';
import { OG_IMAGE, SITE } from '../config/site';
import { pageSchema } from '../lib/schema';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  includeProduct?: boolean;
  includeFaq?: boolean;
  crumbs?: Crumb[];
}

const {
  title = SITE.title,
  description = SITE.description,
  path = '/',
  noindex = false,
  includeProduct = false,
  includeFaq = false,
  crumbs = [],
} = Astro.props;

const canonicalURL = `${SITE.url}${path}`;
const structuredData = noindex
  ? null
  : pageSchema({ path, title, description, crumbs, includeProduct, includeFaq });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#141311" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:secure_url" content={OG_IMAGE} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="waxphx.com premium domain for sale — Phoenix waxing and hair removal" />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content="waxphx.com premium domain for sale — Phoenix waxing and hair removal" />

    {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body class="pb-24 md:pb-0">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:bg-paper focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
